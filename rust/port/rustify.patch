+    #[serde(default)]
+    pub path_aliases: std::collections::BTreeMap<String, String>,
     pub batch: BatchConfig,
 }
 
 impl Config {
+    /// The repository-relative path a `path_aliases` entry maps `specifier` to.
+    pub fn resolve_alias(&self, specifier: &str) -> Option<String> {
+        self.path_aliases
+            .iter()
+            .filter_map(|(key, target)| {
+                let rest = if key.ends_with('/') {
+                    specifier.strip_prefix(key.as_str())?
+                } else if specifier == key {
+                    ""
+                } else {
+                    return None;
+                };
+                Some((key.len(), format!("{target}{rest}")))
+            })
+            .max_by_key(|(len, _)| *len)
+            .map(|(_, path)| path)
+    }
