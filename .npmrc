# @lobehub/icons declares UI peers that are not needed by our deep icon imports.
# This is now a build-only dependency. Keep unused UI peers out of development;
# production consumers must not rely on inheriting this repository's npm config.
legacy-peer-deps=true

# Network resilience: enlarge npm's fetch retry budget so a transient registry
# socket reset (ECONNRESET) mid-download retries instead of failing the job.
# npm defaults to only 2 retries with short timeouts; `npm ci` in
# electron-release.yml hit ECONNRESET during v3.8.41 publish. Applies to every
# CI workflow (electron / docker / unit) and local installs.
fetch-retries=5
fetch-retry-factor=4
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000

# onnxruntime-node bundles the CPU binaries (bin/napi-v6/...) inside the npm
# package, but its postinstall still tries to fetch the CUDA 12 binaries from
# NuGet on linux/x64 by default (~300MB). Skipping that keeps local/CI installs
# network-free and prevents npm's optional-dependency chain (@huggingface/
# transformers) from being dropped entirely whenever that download fails —
# which previously left `@huggingface/transformers` missing after `npm install`
# and broke startup with a crash in the transformers loader.
onnxruntime-node-install=skip
