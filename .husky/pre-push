#!/usr/bin/env sh
# .husky/pre-push — intentionally light.
# Validation belongs in RedRouter CI. Keep only a PATH/npm sanity reminder.
# Intentionally excludes test:unit / typecheck (slow; covered by CI).

if ! command -v npm >/dev/null 2>&1; then
  echo "⚠️  npm not found in PATH — skipping pre-push hooks"
  echo "   Check the RedRouter CI result after pushing."
  exit 0
fi

# No-op success: CI owns validation; there is no pre-commit hook.
exit 0
