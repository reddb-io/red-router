# RedRouter environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/red-router

# Recommended runtime variables
PORT=25050
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:25050
CLOUD_URL=https://github.com/reddb-io/red-router
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:25050
NEXT_PUBLIC_CLOUD_URL=https://github.com/reddb-io/red-router

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Optional TypeSafe (Jev "System One") classifier for the combo "smart" strategy.
# Jev is a decision model, not an LLM: it classifies a coding task into a
# complexity tier (SIMPLE/MEDIUM/COMPLEX/REASONING) BEFORE model ordering, then
# the normal availability/quota fallback ladder runs untouched. Credentials stay
# server-side; the classifier FAILS OPEN (keeps the existing combo order) on any
# timeout, HTTP error, malformed/low-confidence response, or open circuit breaker.
# TYPESAFE_API_KEY=your-typesafe-api-key
# TYPESAFE_API_BASE=https://api.typesafe.ai

# Optional pin for the Claude Code version the "claude" provider advertises
# (User-Agent and billing header). Unset, the router starts from its built-in
# version and adopts the minimum Anthropic names in a claude_code_version_too_old
# error, retrying that request once. Set, this value always wins.
# RED_ROUTER_CLAUDE_CODE_VERSION=2.1.280

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=red-router

# ── Database ────────────────────────────────────────────────────────────────
# Unset (default): SQLite under DATA_DIR — "Local Mode", no setup required.
# Set: the instance uses that Postgres instead — "Distributed Mode" — which is
# what lets several instances share one database. Schema is created on boot.
# Moving between the two goes through Settings → Download backup, then restart
# with (or without) this variable and upload the backup again.
# DATABASE_URL=postgres://user:password@host:5432/redrouter
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=10000
